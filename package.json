{
  "name": "veil-bsv",
  "version": "0.2.2",
  "private": true,
  "description": "Replayable ZEC-style shielded pool on BSV with Groth16 notes and nullifiers",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "postinstall": "ts-patch install -s",
    "build:circuit": "node --import tsx scripts/build-circuit.ts",
    "build:contract": "scrypt-cli compile",
    "build:v4": "scrypt-cli compile -i src/v4/shieldedPoolV4.ts && scrypt-cli compile -i 'src/v4/veilV4*.ts' && node --import tsx scripts/build-v4-chain.ts",
    "verify:v4:deployed": "scrypt-cli compile -i src/v4/legacy/shieldedPoolV4.ts && scrypt-cli compile -i src/v4/legacy/veilV4Finalizer.ts && node --import tsx scripts/build-v4-chain.ts --legacy --vkey=evidence/deployed-verification-key.json --expect=evidence/deployed-v4-chain-manifest.json --out=artifacts/v4/legacy-chain-manifest.json",
    "build": "npm run build:circuit && npm run build:contract",
    "bounty:replay": "npm run build:circuit && npm run build:v4 && npm run verify:v4:deployed && npm run demo && npm run test:v4 && npm test && npm run typecheck && npm run build:ui",
    "release:check": "bash scripts/release-check.sh",
    "release:manifest": "bash scripts/update-manifest.sh",
    "release:package": "bash scripts/package-release.sh",
    "release:package-deployed-artifacts": "bash scripts/package-deployed-artifacts.sh",
    "sync:ui-artifacts": "node --import tsx scripts/sync-ui-artifacts.ts",
    "live-wallet:encrypt": "node --import tsx scripts/encrypt-live-wallet.ts",
    "dev:ui": "npm run sync:ui-artifacts && vite --config ui/vite.config.ts",
    "build:ui": "npm run sync:ui-artifacts && vite build --config ui/vite.config.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "test:onchain": "node --import tsx scripts/verify-onchain.ts",
    "benchmark:verifier": "node --import tsx scripts/benchmark-verifier.ts",
    "test:residue": "node --import tsx scripts/test-residue-witness.ts",
    "test:v4": "node --import tsx scripts/test-v4-chain.ts",
    "deploy:v4:status": "node --import tsx scripts/testnet-v4-deploy.ts status",
    "deploy:v4:dry-run": "node --import tsx scripts/testnet-v4-deploy.ts dry-run",
    "deploy:v4:prepare": "node --import tsx scripts/testnet-v4-deploy.ts prepare",
    "deploy:v4:audit": "node --import tsx scripts/testnet-v4-deploy.ts audit",
    "deploy:v4:send": "node --import tsx scripts/testnet-v4-deploy.ts send",
    "deploy:v4:confirm": "node --import tsx scripts/testnet-v4-deploy.ts confirm",
    "wallet:testnet:init": "node --import tsx scripts/testnet-wallet.ts init",
    "wallet:testnet:status": "node --import tsx scripts/testnet-wallet.ts status",
    "lifecycle:v4:prepare-shield": "node --import tsx scripts/testnet-v4-lifecycle.ts prepare-shield",
    "lifecycle:v4:audit-shield": "node --import tsx scripts/testnet-v4-lifecycle.ts audit-shield",
    "lifecycle:v4:send-split": "node --import tsx scripts/testnet-v4-lifecycle.ts send-split",
    "lifecycle:v4:send-begin": "node --import tsx scripts/testnet-v4-lifecycle.ts send-begin",
    "lifecycle:v4:send-stage": "node --import tsx scripts/testnet-v4-lifecycle.ts send-stage",
    "lifecycle:v4:confirm-shield": "node --import tsx scripts/testnet-v4-lifecycle.ts confirm-shield",
    "lifecycle:v4:prepare-transfer": "node --import tsx scripts/testnet-v4-lifecycle.ts prepare-transfer",
    "lifecycle:v4:audit-transfer": "node --import tsx scripts/testnet-v4-lifecycle.ts audit-transfer",
    "lifecycle:v4:send-transfer-split": "node --import tsx scripts/testnet-v4-lifecycle.ts send-transfer-split",
    "lifecycle:v4:send-transfer-begin": "node --import tsx scripts/testnet-v4-lifecycle.ts send-transfer-begin",
    "lifecycle:v4:send-transfer-stage": "node --import tsx scripts/testnet-v4-lifecycle.ts send-transfer-stage",
    "lifecycle:v4:confirm-transfer": "node --import tsx scripts/testnet-v4-lifecycle.ts confirm-transfer",
    "lifecycle:v4:prepare-lock-test": "node --import tsx scripts/testnet-v4-lock-test.ts prepare",
    "lifecycle:v4:audit-lock-test": "node --import tsx scripts/testnet-v4-lock-test.ts audit",
    "lifecycle:v4:send-locked-shield-chain": "node --import tsx scripts/testnet-v4-lock-test.ts send-locked-shield-chain",
    "lifecycle:v4:send-mature-unshield-chain": "node --import tsx scripts/testnet-v4-lock-test.ts send-mature-unshield-chain",
    "lifecycle:v4:send-early-unshield": "node --import tsx scripts/testnet-v4-lock-test.ts send-early-unshield",
    "probe:init": "node scripts/tor-size-probe.cjs init",
    "probe:status": "node scripts/tor-size-probe.cjs status",
    "probe:dry-run": "node scripts/tor-size-probe.cjs dry-run",
    "probe:send": "node scripts/tor-size-probe.cjs send",
    "deploy:init": "node --import tsx scripts/testnet-deploy.ts init",
    "deploy:status": "node --import tsx scripts/testnet-deploy.ts status",
    "deploy:dry-run": "node --import tsx scripts/testnet-deploy.ts dry-run",
    "deploy:prepare": "node --import tsx scripts/testnet-deploy.ts prepare",
    "deploy:audit": "node --import tsx scripts/testnet-deploy.ts audit",
    "deploy:send": "node --import tsx scripts/testnet-deploy.ts send",
    "deploy:confirm": "node --import tsx scripts/testnet-deploy.ts confirm",
    "lifecycle:prepare-shield": "node --import tsx scripts/testnet-lifecycle.ts prepare-shield",
    "lifecycle:audit-shield": "node --import tsx scripts/testnet-lifecycle.ts audit-shield",
    "lifecycle:send-shield": "node --import tsx scripts/testnet-lifecycle.ts send-shield",
    "lifecycle:testnet": "node --import tsx scripts/testnet-lifecycle.ts",
    "test": "tsx --test --test-force-exit tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "scrypt-ts": "1.4.5",
    "scrypt-ts-lib": "0.1.28",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "circom2": "0.2.22",
    "scrypt-cli": "0.2.3",
    "ts-patch": "3.0.1",
    "tsx": "4.20.5",
    "typescript": "5.3.3",
    "vite": "7.1.5",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
